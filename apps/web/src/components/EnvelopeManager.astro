<section class="mt-11" id="envelope-manager" aria-labelledby="envelope-manager-title">
  <div class="section-heading">
    <div>
      <p class="kicker">Budget workspace</p>
      <h2 class="font-display text-[19px] font-semibold text-[#263548]" id="envelope-manager-title">Manage envelopes</h2>
    </div>
    <button class="rounded bg-coral-500 px-3 py-2 text-[11px] font-bold text-white" data-envelope-action="new" type="button">+ New envelope</button>
  </div>
  <p class="hidden rounded border border-[#F5C1B1] bg-coral-50 px-3 py-2 text-xs text-coral-600" data-envelope-error role="alert"></p>
  <p class="hidden rounded border border-[#B7E4D1] bg-[#EAF8F1] px-3 py-2 text-xs text-[#318C76]" data-envelope-status role="status"></p>
  <div class="grid gap-3 md:grid-cols-2" data-envelope-manager-list>
    <p class="text-xs text-[#82909D]" data-envelope-loading>Loading envelopes...</p>
  </div>
</section>

<dialog class="w-[min(480px,calc(100vw-32px))] rounded-lg border-0 p-0 shadow-[0_20px_60px_rgba(23,37,51,.18)]" data-envelope-dialog>
  <form class="p-5" data-envelope-form>
    <div class="flex items-start justify-between gap-4">
      <div><p class="kicker">Envelope</p><h2 class="font-display text-lg font-semibold text-[#263548]" data-envelope-dialog-title>New envelope</h2></div>
      <button class="text-xl text-[#82909D]" data-envelope-close type="button" aria-label="Close">×</button>
    </div>
    <input type="hidden" data-envelope-id />
    <label class="mt-5 block text-xs font-bold text-[#657386]">Name<input class="mt-1.5 block w-full rounded border border-[#DFE5E0] px-3 py-2.5 text-sm font-normal" data-envelope-name maxlength="80" required /></label>
    <label class="mt-3 block text-xs font-bold text-[#657386]">Category ID<input class="mt-1.5 block w-full rounded border border-[#DFE5E0] px-3 py-2.5 text-sm font-normal" data-envelope-category required list="envelope-category-ids" /></label>
    <datalist id="envelope-category-ids"></datalist>
    <div class="mt-3 grid grid-cols-2 gap-3">
      <label class="block text-xs font-bold text-[#657386]">Budget<input class="mt-1.5 block w-full rounded border border-[#DFE5E0] px-3 py-2.5 text-sm font-normal" data-envelope-budget min="0" required step="0.01" type="number" /></label>
      <label class="block text-xs font-bold text-[#657386]">Reset<select class="mt-1.5 block w-full rounded border border-[#DFE5E0] px-3 py-2.5 text-sm font-normal" data-envelope-reset><option value="monthly">Monthly</option><option value="weekly">Weekly</option><option value="once">Once</option></select></label>
    </div>
    <button class="mt-5 w-full rounded bg-coral-500 px-3 py-3 text-xs font-bold text-white" data-envelope-submit type="submit">Save envelope</button>
  </form>
</dialog>

<script>
  import { createEnvelope, deleteEnvelope, fillEnvelope, getEnvelopeDeletePreview, getEnvelopes, transferEnvelope, updateEnvelope } from '../lib/api-client';
  import type { DeleteEnvelopeInput, EnvelopeItem } from '@pocketflow/shared';

  const manager = document.querySelector('[data-envelope-manager-list]');
  const dialog = document.querySelector('[data-envelope-dialog]') as HTMLDialogElement | null;
  const form = document.querySelector('[data-envelope-form]') as HTMLFormElement | null;
  const errorBox = document.querySelector('[data-envelope-error]');
  const statusBox = document.querySelector('[data-envelope-status]');
  const state: { envelopes: EnvelopeItem[] } = { envelopes: [] };
  const token = () => localStorage.getItem('authToken') ?? '';
  const money = (amount: number) => `Rp ${new Intl.NumberFormat('id-ID').format(amount)}`;
  const show = (element: Element | null, message: string) => { if (element) { element.textContent = message; element.classList.remove('hidden'); } };
  const clearMessages = () => { errorBox?.classList.add('hidden'); statusBox?.classList.add('hidden'); };
  const field = (name: string) => document.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-envelope-${name}]`);

  const load = async () => {
    const result = await getEnvelopes(token());
    state.envelopes = result.data;
    render();
  };

  const render = () => {
    if (!manager) return;
    manager.replaceChildren();
    const datalist = document.querySelector('#envelope-category-ids');
    datalist?.replaceChildren(...state.envelopes.map((item) => { const option = document.createElement('option'); option.value = item.categoryId; option.label = item.categoryName ?? item.name; return option; }));
    if (state.envelopes.length === 0) { const empty = document.createElement('p'); empty.className = 'text-xs text-[#82909D]'; empty.textContent = 'No envelopes yet. Create your first budget envelope.'; manager.append(empty); return; }
    state.envelopes.forEach((item) => {
      const card = document.createElement('article');
      card.className = 'rounded-lg border border-[#E8EBE6] bg-white p-4';
      const percentage = item.budgetedAmount > 0 ? Math.round((item.currentAmount / item.budgetedAmount) * 100) : 0;
      card.innerHTML = `<div class="flex items-start justify-between gap-3"><div><h3 class="font-display text-sm font-semibold text-[#263548]">${item.name}</h3><p class="mt-1 text-[10px] text-[#82909D]">${item.categoryName ?? item.categoryId} · ${item.resetFrequency}</p></div><strong class="text-xs text-[#263548]">${money(item.currentAmount)}</strong></div><div class="mt-3 h-1.5 overflow-hidden rounded-full bg-[#EDF0ED]"><span class="block h-full rounded-full ${percentage >= 100 ? 'bg-[#EF4444]' : percentage >= 70 ? 'bg-[#F2B84B]' : 'bg-[#56B994]'}" style="width:${Math.min(Math.max(percentage, 0), 100)}%"></span></div><p class="mt-2 text-[10px] text-[#82909D]">Budget ${money(item.budgetedAmount)} · ${item.relatedTransactionCount ?? 0} transactions</p><div class="mt-3 flex flex-wrap gap-2"><button class="rounded border border-[#DFE5E0] px-2 py-1.5 text-[10px] font-bold text-[#657386]" data-envelope-action="edit" data-id="${item.id}" type="button">Edit</button><button class="rounded border border-[#DFE5E0] px-2 py-1.5 text-[10px] font-bold text-[#657386]" data-envelope-action="fill" data-id="${item.id}" type="button">Fill</button><button class="rounded border border-[#DFE5E0] px-2 py-1.5 text-[10px] font-bold text-[#657386]" data-envelope-action="transfer" data-id="${item.id}" type="button">Transfer</button><button class="rounded border border-[#F5C1B1] px-2 py-1.5 text-[10px] font-bold text-[#C6533D]" data-envelope-action="delete" data-id="${item.id}" type="button">Delete</button></div>`;
      manager.append(card);
    });
  };

  const openForm = (item: EnvelopeItem | null) => {
    field('id')!.value = item?.id ?? '';
    field('name')!.value = item?.name ?? '';
    field('category')!.value = item?.categoryId ?? '';
    field('budget')!.value = String(item?.budgetedAmount ?? 0);
    field('reset')!.value = item?.resetFrequency ?? 'monthly';
    document.querySelector('[data-envelope-dialog-title]')!.textContent = item ? 'Edit envelope' : 'New envelope';
    dialog?.showModal();
  };

  document.querySelector('[data-envelope-action="new"]')?.addEventListener('click', () => openForm(null));
  document.querySelector('[data-envelope-close]')?.addEventListener('click', () => dialog?.close());
  form?.addEventListener('submit', async (event) => {
    event.preventDefault(); clearMessages();
    try {
      const input = { name: field('name')!.value, categoryId: field('category')!.value, budgetedAmount: Number(field('budget')!.value), resetFrequency: field('reset')!.value as 'monthly' | 'weekly' | 'once' };
      const id = field('id')!.value;
      if (id) await updateEnvelope(token(), id, input); else await createEnvelope(token(), input);
      dialog?.close(); await load(); show(statusBox, 'Envelope saved.');
    } catch (value) { show(errorBox, value instanceof Error ? value.message : 'Unable to save envelope.'); }
  });

  manager?.addEventListener('click', async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>('[data-envelope-action]');
    if (!button || button.dataset.envelopeAction === 'new') return;
    clearMessages();
    const item = state.envelopes.find((envelope) => envelope.id === button.dataset.id);
    if (!item) return;
    try {
      if (button.dataset.envelopeAction === 'edit') return openForm(item);
      if (button.dataset.envelopeAction === 'fill') { const amount = Number(window.prompt(`Amount to fill ${item.name}:`, '0')); if (amount > 0) { await fillEnvelope(token(), item.id, { amount }); await load(); show(statusBox, 'Envelope filled.'); } return; }
      if (button.dataset.envelopeAction === 'transfer') { const target = window.prompt('Destination envelope ID:'); const amount = Number(window.prompt('Amount to transfer:', '0')); if (target && amount > 0) { await transferEnvelope(token(), { fromEnvelopeId: item.id, toEnvelopeId: target, amount }); await load(); show(statusBox, 'Funds transferred.'); } return; }
      const preview = (await getEnvelopeDeletePreview(token(), item.id)).data;
      let input: DeleteEnvelopeInput = { returnToAvailableToSpend: false };
      if (preview.requiresBalanceAction) {
        const target = window.prompt(`${money(preview.currentAmount)} remains. Enter target envelope ID, or type AVAILABLE:`, 'AVAILABLE');
        if (!target) return;
        input = target.toUpperCase() === 'AVAILABLE' ? { returnToAvailableToSpend: true } : { transferToEnvelopeId: target, returnToAvailableToSpend: false };
      }
      if (window.confirm(`Delete ${item.name}? ${preview.relatedTransactionCount} related transactions will be removed.`)) { await deleteEnvelope(token(), item.id, input); await load(); show(statusBox, 'Envelope deleted.'); }
    } catch (value) { show(errorBox, value instanceof Error ? value.message : 'Envelope action failed.'); }
  });

  document.addEventListener('pocketflow:dashboard-ready', () => load().catch((value) => show(errorBox, value instanceof Error ? value.message : 'Unable to load envelopes.')));
</script>