<script>
import { validateReceiptFile } from '@pocketflow/shared';

const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8787';

async function fetchDashboard(token: string) {
  const res = await fetch(`${API_URL}/api/dashboard`, { headers: { Authorization: `Bearer ${token}` } });
  const data = await res.json();
  if (!data.success) throw new Error('Failed to load dashboard');
  return data;
}

async function createTransactionApi(token: string, input: unknown) {
  const res = await fetch(`${API_URL}/api/transactions`, {
    method: 'POST',
    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
    body: JSON.stringify(input),
  });
  const data = await res.json();
  if (!data.success) throw new Error(data.error?.message || 'Create transaction failed');
  return data;
}

async function fetchTransactionApi(token: string, id: string) {
  const res = await fetch(`${API_URL}/api/transactions/${id}`, { headers: { Authorization: `Bearer ${token}` } });
  const data = await res.json();
  if (!res.ok || !data.success) throw new Error(data.error?.message || 'Failed to load transaction');
  return data.data;
}

async function updateTransactionApi(token: string, id: string, input: unknown) {
  const res = await fetch(`${API_URL}/api/transactions/${id}`, {
    method: 'PUT',
    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
    body: JSON.stringify(input),
  });
  const data = await res.json();
  if (!res.ok || !data.success) throw new Error(data.error?.message || 'Update transaction failed');
  return data;
}

async function uploadReceiptApi(token: string, file: File) {
  const uploadData = new FormData();
  uploadData.append('receipt', file);
  const res = await fetch(`${API_URL}/api/receipts`, {
    method: 'POST',
    headers: { Authorization: `Bearer ${token}` },
    body: uploadData,
  });
  const data = await res.json();
  if (!res.ok || !data.success) throw new Error(data.error?.message || 'Receipt upload failed');
  return data.data.receiptUrl;
}


let envelopes: Array<{ id: string; name: string }> = [];

const formatAmount = (value: number | string) => value === '' ? '' : new Intl.NumberFormat('id-ID').format(Number(value));

function token() {
  return localStorage.getItem('authToken') ?? '';
}

type TransactionDraft = {
  id?: string;
  type?: string;
  amount?: number;
  description?: string;
  date?: string;
  envelopeId?: string | null;
  destinationEnvelopeId?: string | null;
  receiptImageUrl?: string | null;
};

function renderForm(transaction: TransactionDraft | null = null) {
  const modal = document.getElementById('add-transaction-modal');
  if (!modal) return;
  const contentDiv = modal.querySelector('.modal-content');
  if (!contentDiv) return;
  const isEdit = Boolean(transaction);
  const today = new Date();
  const maxDate = new Date(today);
  maxDate.setFullYear(maxDate.getFullYear() + 1);
  const dateValue = transaction ? new Date(transaction.date ?? '').toISOString().slice(0, 10) : today.toISOString().slice(0, 10);
  const selectedType = transaction?.type ?? 'expense';
  const formHtml = `
    <form id="add-transaction-form" class="space-y-4">
      <div class="flex items-start justify-between mb-6">
        <h2 id="modal-title" class="font-display text-2xl font-semibold text-[#213043]">${isEdit ? 'Edit Transaction' : 'Add Transaction'}</h2>
        <button type="button" class="modal-close border-0 bg-transparent text-[25px] text-[#82909D]" aria-label="Close dialog">×</button>
      </div>
      <fieldset><legend class="text-sm font-medium text-gray-700">Type</legend>
        <div class="mt-1 grid grid-cols-3 gap-1 rounded-md bg-[#F1F3F1] p-1">
          ${['expense', 'income', 'transfer'].map(type => `<button type="button" class="transaction-type rounded px-2 py-2 text-xs font-semibold ${selectedType === type ? 'bg-white text-[#D66D57] shadow-sm' : 'text-[#82909D]'}" data-type="${type}" aria-pressed="${selectedType === type}">${type.charAt(0).toUpperCase() + type.slice(1)}</button>`).join('')}
        </div>
        <input type="hidden" name="type" value="${selectedType}" /></fieldset>
      <label class="block"><span class="text-sm font-medium text-gray-700">Amount</span>
        <div class="relative mt-1"><span class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center text-sm text-[#82909D]">Rp</span>
          <input type="text" name="amount" inputmode="decimal" value="${formatAmount(transaction?.amount ?? '')}" class="block w-full rounded-md border-gray-300 pl-10" required aria-describedby="transaction-form-error" /></div></label>
      <label class="block"><span class="text-sm font-medium text-gray-700">Description</span>
        <input type="text" name="description" value="${transaction?.description ?? ''}" class="mt-1 block w-full border-gray-300 rounded-md" required /></label>
      <label class="block"><span class="text-sm font-medium text-gray-700">Date</span>
        <input type="date" name="date" value="${dateValue}" max="${maxDate.toISOString().slice(0, 10)}" class="mt-1 block w-full border-gray-300 rounded-md" required /></label>
      <label class="envelope-field block ${selectedType === 'income' ? 'hidden' : ''}"><span class="text-sm font-medium text-gray-700">Envelope</span>
        <select name="envelopeId" class="mt-1 block w-full border-gray-300 rounded-md">
          <option value="">No envelope</option>${envelopes.map(e => `<option value="${e.id}" ${transaction?.envelopeId === e.id ? 'selected' : ''}>${e.name}</option>`).join('')}
        </select></label>
      <div class="income-notice block ${selectedType === 'income' ? '' : 'hidden'} rounded-md bg-[#E8F7F0] p-3 text-xs text-[#10B981]">
        <strong>💰 Income Info:</strong> Income will be added to your "Available to Spend" pool. Use the "Fill Envelope" feature to allocate funds to specific envelopes.
      </div>
      <label class="destination-envelope block ${selectedType === 'transfer' ? '' : 'hidden'}"><span class="text-sm font-medium text-gray-700">Destination envelope</span>
        <select name="destinationEnvelopeId" class="mt-1 block w-full border-gray-300 rounded-md">
          <option value="">No destination</option>${envelopes.map(e => `<option value="${e.id}" ${transaction?.destinationEnvelopeId === e.id ? 'selected' : ''}>${e.name}</option>`).join('')}
        </select></label>
      <label class="block"><span class="text-sm font-medium text-gray-700">Receipt</span>
        <input type="file" name="receipt" accept="image/jpeg,image/png" class="mt-1 block w-full text-xs" />
        ${transaction?.receiptImageUrl ? `<div class="mt-1 flex items-center gap-2"><span class="text-xs text-[#10B981]">Receipt attached</span><label class="flex items-center gap-1 text-xs text-red-600"><input type="checkbox" name="removeReceipt" /> Remove</label></div>` : ''}</label>
      <p id="transaction-form-error" class="hidden text-xs text-red-600"></p>
      <div class="flex justify-end space-x-2 pt-4">
        <button type="button" class="modal-cancel px-4 py-2 bg-gray-200 rounded">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">${isEdit ? 'Save' : 'Create'}</button>
      </div>
    </form>
  `;
  contentDiv.innerHTML = formHtml;
  const form = document.getElementById('add-transaction-form') as HTMLFormElement;
  const typeInput = form.querySelector('input[name="type"]') as HTMLInputElement;
  const envelopeField = form.querySelector('.envelope-field') as HTMLElement;
  const incomeNotice = form.querySelector('.income-notice') as HTMLElement;
  const destinationField = form.querySelector('.destination-envelope') as HTMLElement;
  const typeButtons = form.querySelectorAll('.transaction-type');
  const updateType = (type: string) => {
    typeInput.value = type;
    envelopeField.classList.toggle('hidden', type === 'income');
    incomeNotice.classList.toggle('hidden', type !== 'income');
    destinationField.classList.toggle('hidden', type !== 'transfer');
    typeButtons.forEach((button) => {
      const active = (button as HTMLElement).dataset.type === type;
      button.classList.toggle('bg-white', active);
      button.classList.toggle('text-[#D66D57]', active);
      button.classList.toggle('shadow-sm', active);
      button.classList.toggle('text-[#82909D]', !active);
      button.setAttribute('aria-pressed', String(active));
    });
  };
  typeButtons.forEach((button) => { const el = button as HTMLElement; el.addEventListener('click', () => updateType(el.dataset.type ?? '')); });
  const amountInput = form.querySelector('input[name="amount"]') as HTMLInputElement;
  amountInput.addEventListener('input', () => {
    const digits = amountInput.value.replace(/[^\d]/g, '');
    amountInput.value = digits ? formatAmount(digits) : '';
  });
  (form.querySelector('.modal-close') as Element).addEventListener('click', close);
  (form.querySelector('.modal-cancel') as Element).addEventListener('click', close);
  form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const formError = document.getElementById('transaction-form-error');
      if (!formError) return;
      formError.classList.add('hidden');
      const type = String(data.get('type'));
      const envelopeId = String(data.get('envelopeId') || '') || null;
      const destinationEnvelopeId = String(data.get('destinationEnvelopeId') || '') || null;
      const date = String(data.get('date'));
      const amountText = String(data.get('amount') || '').replace(/[^\d]/g, '');
      const amount = Number(amountText);
      if (!amountText || !Number.isFinite(amount) || amount <= 0) {
        formError.textContent = 'Amount must be a number greater than 0.';
        formError.classList.remove('hidden');
        return;
      }
      if (!date || Number.isNaN(new Date(`${date}T00:00:00`).getTime())) {
        formError.textContent = 'Please enter a valid date.';
        formError.classList.remove('hidden');
        return;
      }
      const maxDateValue = new Date();
      maxDateValue.setFullYear(maxDateValue.getFullYear() + 1);
      if (new Date(`${date}T23:59:59`).getTime() > maxDateValue.getTime()) {
        formError.textContent = 'Date cannot be more than 1 year in the future.';
        formError.classList.remove('hidden');
        return;
      }
      if (type === 'income' && envelopeId) {
        formError.textContent = 'Income transactions cannot be assigned to an envelope. Use Fill Envelope feature instead.';
        formError.classList.remove('hidden');
        return;
      }
      if (type === 'expense' && !envelopeId) {
        formError.textContent = 'Envelope is required for expense transactions.';
        formError.classList.remove('hidden');
        return;
      }
      if (type === 'transfer' && (!envelopeId || !destinationEnvelopeId)) {
        formError.textContent = 'Transfers require source and destination envelopes.';
        formError.classList.remove('hidden');
        return;
      }
      if (type === 'transfer' && envelopeId === destinationEnvelopeId) {
        formError.textContent = 'Source and destination envelopes must be different.';
        formError.classList.remove('hidden');
        return;
      }
      const receiptFile = data.get('receipt');
      const removeReceipt = (form.querySelector('input[name="removeReceipt"]') as HTMLInputElement | null)?.checked ?? false;
      /** @type {{ type: string; amount: number; description: string; date: string; envelopeId: string | null; destinationEnvelopeId: string | null; receiptImageUrl?: string | null }} */
      const input: { type: string; amount: number; description: string; date: string; envelopeId: string | null; destinationEnvelopeId: string | null; receiptImageUrl?: string | null } = {
        type,
        amount,
        description: String(data.get('description')),
        date,
        envelopeId,
        destinationEnvelopeId,
      };
      try {
        // Upload-first: validate and upload the receipt before touching the
        // transaction, so a failed upload never corrupts saved data.
        if (receiptFile instanceof File && receiptFile.size > 0) {
          const validation = validateReceiptFile({ type: receiptFile.type, size: receiptFile.size });
          if (!validation.ok) {
            formError.textContent = validation.message;
            formError.classList.remove('hidden');
            return;
          }
          input.receiptImageUrl = await uploadReceiptApi(token(), receiptFile);
        } else if (isEdit && removeReceipt) {
          input.receiptImageUrl = null;
        } else if (isEdit && transaction?.receiptImageUrl) {
          input.receiptImageUrl = transaction.receiptImageUrl;
        }
        if (isEdit && transaction?.id) {
          await updateTransactionApi(token(), transaction.id, input);
        } else {
          await createTransactionApi(token(), input);
        }
        close();
      } catch (err) {
        formError.textContent = err instanceof Error ? err.message : String(err);
        formError.classList.remove('hidden');
      }
  });
}

async function open(event?: Event) {
  const detailId = (event as CustomEvent | undefined)?.detail?.id as string | undefined;
  const el = document.getElementById('add-transaction-modal');
  if (!el) return;
  try {
    const [dashboard, transaction] = await Promise.all([
      fetchDashboard(token()),
      detailId ? fetchTransactionApi(token(), detailId) : Promise.resolve(null),
    ]);
    envelopes = dashboard.data.envelopes;
    renderForm(transaction);
    el.style.display = 'grid';
  } catch (error) {
    alert(error instanceof Error ? error.message : 'Failed to load transaction form');
  }
}

export function close() {
  const el = document.getElementById('add-transaction-modal');
  if (el) el.style.display = 'none';
  document.dispatchEvent(new CustomEvent('pocketflow:refresh-data'));
}

document.addEventListener('pocketflow:open-add-transaction', open);
document.addEventListener('pocketflow:edit-transaction', open);
</script>

<div id="add-transaction-modal" class="modal-backdrop fixed inset-0 z-20 hidden place-items-center bg-[rgba(25,39,53,.4)] p-5" aria-hidden="true">
  <div class="max-h-[90vh] w-full max-w-[410px] overflow-y-auto rounded-[10px] bg-white p-[29px] shadow-[0_20px_60px_rgba(23,37,51,.22)]" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-content">
      <!-- Form will be injected here -->
    </div>
  </div>
</div>
