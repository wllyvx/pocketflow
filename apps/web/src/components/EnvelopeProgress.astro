---
const envelopes = [
  { icon: '⌂', tone: 'bg-[#E0F4ED] text-[#318C76]', name: 'Home & utilities', used: 'Rp 2,100,000', budget: 'Rp 3,000,000', percent: 70, left: 'Rp 900,000 left', bar: 'bg-[#56B994]' },
  { icon: '✦', tone: 'bg-[#FFEAE4] text-[#D96F58]', name: 'Food & groceries', used: 'Rp 1,740,000', budget: 'Rp 2,000,000', percent: 87, left: 'Rp 260,000 left', bar: 'bg-[#EF876A]', warning: true },
  { icon: '⌁', tone: 'bg-[#FFF2CF] text-[#B68A32]', name: 'Getting around', used: 'Rp 680,000', budget: 'Rp 1,500,000', percent: 45, left: 'Rp 820,000 left', bar: 'bg-[#E8B454]' },
];
---

<section class="mt-11" id="envelopes"><div class="section-heading"><div><p class="kicker">YOUR PLAN</p><h2 class="font-display text-xl font-semibold tracking-[-.5px] text-[#213043]">Envelope progress</h2></div><a class="text-link" href="#all-envelopes">View all <span>→</span></a></div><div class="grid grid-cols-4 gap-3.5 max-lg:grid-cols-2 max-[680px]:gap-2">
  {envelopes.map((envelope) => <article class="min-h-[182px] rounded-lg border border-[#E8EBE6] bg-white p-[19px_18px] transition-standard hover:-translate-y-0.5 hover:border-[#F1B2A0] hover:shadow-[0_10px_24px_rgba(52,67,77,.07)] max-[680px]:min-h-[170px] max-[680px]:p-[15px_13px]"><div class="flex items-center justify-between"><span class:list={['grid h-[31px] w-[31px] place-items-center rounded-md text-lg font-bold', envelope.tone]}>{envelope.icon}</span><span class:list={['h-1.5 w-1.5 rounded-full', envelope.warning ? 'bg-[#EFAA56]' : 'bg-[#58BB91']}></span></div><h3 class="mt-[15px] font-display text-[13px] font-semibold text-[#334154] max-[680px]:text-xs">{envelope.name}</h3><p class="mt-2 text-[11px] font-bold text-[#263548] max-[680px]:text-[10px]">{envelope.used} <span class="font-normal text-[#A1AAB4]">/ {envelope.budget}</span></p><div class="mt-[17px] h-1.5 overflow-hidden rounded-full bg-[#EDF0ED]"><span class:list={['block h-full rounded-full', envelope.bar]} style={`width: ${envelope.percent}%`}></span></div><div class="mt-2 flex justify-between text-[9px] text-[#9CA6AF] max-[680px]:block max-[680px]:leading-6"><span>{envelope.percent}% used</span><strong class="font-semibold text-[#687688] max-[680px]:block">{envelope.left}</strong></div></article>)}
  <button class="flex min-h-[182px] flex-col items-center justify-center rounded-lg border border-dashed border-[#CFD7D2] bg-transparent text-[#7D8995] max-lg:min-h-[170px]" type="button"><span class="mb-3 grid h-[31px] w-[31px] place-items-center rounded-full bg-[#FFEAE5] text-[23px] font-light text-coral-500">+</span><strong class="text-xs text-[#526174]">New envelope</strong><small class="mt-1 text-[10px]">Give every rupiah a job</small></button>
</div></section>
