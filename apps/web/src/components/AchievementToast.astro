<div id="achievement-toast-container" class="fixed bottom-6 left-1/2 z-40 flex -translate-x-1/2 flex-col items-center gap-3" aria-live="polite"></div>

<script>
  import type { AchievementUnlockNotification } from '@pocketflow/shared';
  import { getAchievementIcon } from '../lib/achievement-icons';

  const TOAST_VISIBLE_MS = 4500;
  const TOAST_STAGGER_MS = 600;

  const showToast = (achievement: AchievementUnlockNotification) => {
    const container = document.querySelector('#achievement-toast-container');
    if (!container) return;

    const iconSvg = getAchievementIcon(achievement.icon) || '<span aria-hidden="true">✦</span>';
    const toast = document.createElement('div');
    toast.setAttribute('role', 'status');
    toast.className = 'achievement-toast pointer-events-auto flex items-center gap-3 rounded-lg border border-[#BFE3D2] bg-white px-4 py-3 shadow-[0_12px_32px_rgba(23,37,51,.16)]';

    const icon = document.createElement('span');
    icon.className = 'achievement-toast-icon grid h-10 w-10 flex-none place-items-center rounded-md bg-[#E0F4ED] text-[#42A27E]';
    icon.setAttribute('aria-hidden', 'true');
    icon.innerHTML = iconSvg;

    const body = document.createElement('div');
    body.className = 'min-w-0';
    const kicker = document.createElement('p');
    kicker.className = 'text-[9px] font-bold uppercase tracking-[0.11em] text-[#42A27E]';
    kicker.textContent = 'Achievement unlocked!';
    const title = document.createElement('h3');
    title.className = 'font-display text-[13px] font-bold text-[#334154]';
    title.textContent = achievement.name;
    const description = document.createElement('p');
    description.className = 'mt-1 truncate text-[11px] text-[#687586]';
    description.textContent = achievement.description;
    body.append(kicker, title, description);

    toast.append(icon, body);
    container.append(toast);

    requestAnimationFrame(() => toast.classList.add('is-visible'));
    setTimeout(() => {
      toast.classList.remove('is-visible');
      setTimeout(() => toast.remove(), 300);
    }, TOAST_VISIBLE_MS);
  };

  let queue: AchievementUnlockNotification[] = [];
  let showing = false;

  const processQueue = () => {
    if (showing) return;
    const achievement = queue.shift();
    if (!achievement) return;
    showing = true;
    showToast(achievement);
    setTimeout(() => {
      showing = false;
      processQueue();
    }, TOAST_STAGGER_MS);
  };

  document.addEventListener('pocketflow:achievements-unlocked', (event) => {
    queue.push(...(event as CustomEvent<AchievementUnlockNotification[]>).detail);
    processQueue();
  });
</script>

<style is:global>
  .achievement-toast-icon svg {
    width: 20px;
    height: 20px;
  }

  .achievement-toast {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.3s ease-in-out,
      transform 0.3s ease-in-out;
  }

  .achievement-toast.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
