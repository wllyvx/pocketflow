<article class="min-w-0" id="spending-rhythm">
  <div class="section-heading">
    <div>
      <p class="kicker">A QUICK LOOK</p>
      <h2 class="font-display text-xl font-semibold tracking-[-.5px] text-[#213043]">Spending rhythm</h2>
    </div>
    <a
      href="/insights"
      class="rounded border border-[#E5EAE5] bg-transparent px-2 py-1.5 text-[10px] font-semibold text-[#6B7888] no-underline transition-fast hover:border-coral-300 hover:text-coral-600"
    >This month · Full insights →</a>
  </div>

  <div id="rhythm-chart" class="mt-2 flex h-[154px]">
    <div class="flex flex-col justify-between pb-4 pr-3 text-[9px] text-[#AEB6BE]" aria-hidden="true">
      <span>max</span>
      <span></span>
      <span></span>
      <span>0</span>
    </div>
    <div class="relative flex-1">
      <div class="absolute inset-0 bottom-4 flex flex-col justify-between">
        <i class="h-px bg-[#E9EDE9]"></i>
        <i class="h-px bg-[#E9EDE9]"></i>
        <i class="h-px bg-[#E9EDE9]"></i>
        <i class="h-px bg-[#E9EDE9]"></i>
      </div>
      <svg
        id="rhythm-svg"
        class="absolute bottom-4 h-[calc(100%-16px)] w-full overflow-visible"
        viewBox="0 0 390 150"
        preserveAspectRatio="none"
        role="img"
        aria-label="Spending trend for the current month"
      >
        <path id="rhythm-area" fill="#FCEDE7" opacity=".7" d=""></path>
        <path
          id="rhythm-line"
          fill="none"
          stroke="#ED8066"
          stroke-width="2.5"
          vector-effect="non-scaling-stroke"
          d=""
        ></path>
        <circle id="rhythm-dot" r="5" fill="white" stroke="#ED8066" stroke-width="3" cx="0" cy="150" visibility="hidden"></circle>
      </svg>
    </div>
  </div>

  <div id="rhythm-empty" class="mt-2 hidden h-[154px] flex-col items-center justify-center rounded-md border border-dashed border-[#E5EAE5] px-6 text-center">
    <p class="font-display text-sm font-semibold text-[#334154]">No spending this month yet</p>
    <p class="mt-1 text-[11px] leading-5 text-[#687586]">Log an expense and your rhythm will show up here.</p>
  </div>

  <div class="flex items-center justify-between border-t border-[#EDF0ED] pt-3.5 text-[10px] text-[#8C98A2]">
    <span><i class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-[#ED8066]"></i>Spending this month</span>
    <strong id="rhythm-spending" class="text-[11px] text-[#4D5C6D]">Rp 0</strong>
  </div>
</article>
