<div id="auth-gate" class="fixed inset-0 z-30 grid place-items-center bg-[#F5F6F2] p-5">
  <div class="w-full max-w-[440px] rounded-[10px] bg-white p-8 shadow-[0_20px_60px_rgba(23,37,51,.12)]">
    <p class="kicker">POCKETFLOW</p>
    <h1 id="auth-title" class="font-display text-3xl font-semibold text-[#213043]">Your money, in rhythm.</h1>
    <p id="auth-message" class="mt-3 text-sm leading-6 text-[#687586]">Checking your session...</p>
    <div id="auth-error" class="mt-4 hidden rounded border border-[#F5C1B1] bg-coral-50 px-3 py-2 text-xs text-coral-600"></div>
    <button id="auth-login" class="mt-7 hidden w-full rounded bg-coral-500 px-3 py-3 text-xs font-bold text-white" type="button">Log in or sign up <span class="ml-2 text-base">→</span></button>

    <form id="onboarding-form" class="mt-7 hidden">
      <label class="block text-xs font-bold text-[#657386]" for="display-name">Display name<input id="display-name" class="mt-1.5 block w-full rounded border border-[#DFE5E0] px-3 py-2.5 text-sm font-normal text-[#354356]" type="text" maxlength="80" autocomplete="name" placeholder="What should we call you?" required /></label>
      <fieldset class="border-0 p-0">
        <legend class="text-sm font-bold text-[#354356]">Start with a few envelopes</legend>
        <p class="mt-1 text-xs leading-5 text-[#82909D]">Choose 3 to 5. You can change these later, or skip for an empty dashboard.</p>
        <div class="mt-5 grid gap-2">
          {['Groceries', 'Transport', 'Fun', 'Bills', 'Health'].map((name) => (
            <label class="flex cursor-pointer items-center gap-3 rounded border border-[#E5EAE6] px-3 py-3 text-sm text-[#465468] has-[:checked]:border-[#F5C1B1] has-[:checked]:bg-coral-50">
              <input class="starter-envelope accent-coral-500" type="checkbox" value={name} />
              {name}
            </label>
          ))}
        </div>
      </fieldset>
      <div class="mt-6 flex gap-3">
        <button id="onboarding-skip" class="flex-1 rounded border border-[#DFE5E0] px-3 py-3 text-xs font-bold text-[#657386]" type="button">Skip</button>
        <button class="flex-1 rounded bg-coral-500 px-3 py-3 text-xs font-bold text-white" type="submit">Continue <span class="ml-2 text-base">→</span></button>
      </div>
    </form>
  </div>
</div>

<script>
  import { completeOnboarding, getCurrentUser, getDashboard, getOnboardingStatus } from '../lib/api-client';
  import { getAuthClient } from '../lib/auth-client';

  const gate = document.querySelector('#auth-gate');
  const loginButton = document.querySelector('#auth-login');
  const onboardingForm = document.querySelector('#onboarding-form') as HTMLFormElement | null;
  const displayNameInput = document.querySelector('#display-name') as HTMLInputElement | null;
  const skipButton = document.querySelector('#onboarding-skip');
  const message = document.querySelector('#auth-message');
  const error = document.querySelector('#auth-error');
  const title = document.querySelector('#auth-title');
  const appShell = document.querySelector('#app-shell');

  const getUserFacingError = (value: unknown) => {
    const message = value instanceof Error ? value.message : '';
    if (/user_exists|already exists|email.*(registered|exists)|duplicate/i.test(message)) {
      return 'Email sudah terdaftar. Silakan masuk menggunakan akun tersebut.';
    }
    return message || 'Terjadi kesalahan. Silakan coba lagi.';
  };

  const showError = (value: unknown) => {
    if (!error) return;
    error.textContent = getUserFacingError(value);
    error.classList.remove('hidden');
  };

  const clearError = () => error?.classList.add('hidden');

  const showDashboard = (name: string, dashboard: Awaited<ReturnType<typeof getDashboard>>['data']) => {
    appShell?.classList.remove('hidden');
    document.dispatchEvent(new CustomEvent('pocketflow:dashboard-ready', { detail: dashboard }));
    gate?.remove();
    document.querySelector('[data-user-name]')?.replaceChildren(name);
    document.querySelector('[data-user-greeting]')?.replaceChildren(name);
    document.querySelector('[data-sidebar-user-name]')?.replaceChildren(name);
  };

  const finishOnboarding = async (token: string, skip: boolean) => {
    const displayName = displayNameInput?.value.trim() ?? '';
    if (!displayName) {
      displayNameInput?.focus();
      throw new Error('Please enter a display name.');
    }
    const starterEnvelopes = skip
      ? []
      : Array.from(document.querySelectorAll<HTMLInputElement>('.starter-envelope:checked')).map((input) => input.value);
    if (!skip && starterEnvelopes.length < 3) {
      throw new Error(`Pilih minimal 3 envelope untuk melanjutkan. Saat ini baru ${starterEnvelopes.length} yang dipilih.`);
    }
    await completeOnboarding(token, { displayName, skip, starterEnvelopes });
    window.location.reload();
  };

  const bootstrap = async () => {
    const auth = await getAuthClient();
    if (window.location.search.includes('code=') && window.location.search.includes('state=')) {
      await auth.handleRedirectCallback();
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    if (!(await auth.isAuthenticated())) {
      if (message) message.textContent = 'Log in to connect your PocketFlow account.';
      loginButton?.classList.remove('hidden');
      return;
    }

    const token = await auth.getTokenSilently();
    localStorage.setItem('authToken', token);
    const user = await getCurrentUser(token);
    const onboarding = await getOnboardingStatus(token);
    if (onboarding.data.status === 'pending') {
      title?.replaceChildren('Welcome to PocketFlow.');
      message?.replaceChildren('Pick a few starter envelopes, or skip to begin with an empty dashboard.');
      onboardingForm?.classList.remove('hidden');
      return;
    }
    const dashboard = await getDashboard(token);
    showDashboard(user.data.name, dashboard.data);
  };

  document.querySelector('#logout-button')?.addEventListener('click', async () => {
    localStorage.removeItem('authToken');
    await (await getAuthClient()).logout({ logoutParams: { returnTo: window.location.origin } });
  });

  loginButton?.addEventListener('click', async () => {
    try {
      await (await getAuthClient()).loginWithRedirect();
    } catch (value) {
      showError(value);
    }
  });

  onboardingForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearError();
    try {
      await finishOnboarding(await (await getAuthClient()).getTokenSilently(), false);
    } catch (value) {
      showError(value);
    }
  });

  skipButton?.addEventListener('click', async () => {
    clearError();
    try {
      await finishOnboarding(await (await getAuthClient()).getTokenSilently(), true);
    } catch (value) {
      showError(value);
    }
  });

  bootstrap().catch(showError);
</script>