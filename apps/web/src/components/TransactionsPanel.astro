<script type="module" is:inline>
function buildQuery(params) {
  return Object.entries(params)
    .filter(([, v]) => v !== undefined && v !== '')
    .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)
    .join('&');
}

// Global state (client‑side only)
let state = {
  page: 1,
  limit: 10,
  type: '',
  envelopeId: ''
};
let envelopes = [];
let envelopeById = new Map();

// Reference to container elements (will be set after DOM is ready)
let panelEl, filtersEl, paginationEl;
function getApiUrl() {
  return document.body.dataset.apiUrl ?? 'http://localhost:8787';
}

async function load() {
  const token = localStorage.getItem('authToken') ?? '';
  const query = buildQuery({ page: state.page, limit: state.limit, type: state.type, envelopeId: state.envelopeId });
  const res = await fetch(`${getApiUrl()}/api/transactions?${query}`, {
    headers: { Authorization: `Bearer ${token}` }
  });
  const data = await res.json();
  if (!data.success) {
    panelEl.innerHTML = `<p class="text-xs text-red-600">Failed to load transactions.</p>`;
    return;
  }
  renderTransactions(data.data);
  renderPagination(data.pagination);
}

function escapeHtml(value) {
  return String(value ?? '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
}

function formatAmount(tx) {
  const amount = `Rp ${new Intl.NumberFormat('id-ID').format(Number(tx.amount))}`;
  return tx.type === 'income' ? `+ ${amount}` : tx.type === 'expense' ? `- ${amount}` : amount;
}

function renderTransactions(items) {
  if (items.length === 0) {
    panelEl.innerHTML = `<p class="text-xs text-[#82909D]">No transactions found.</p>`;
    return;
  }
  const rows = items.map(tx => `
    <div class="flex items-center border-b px-2 py-2 last:border-b-0 ${envelopeById.get(tx.envelopeId)?.currentAmount < 0 ? 'bg-[#FFF5F2]' : ''}">
      <span class="grid h-7 w-7 place-items-center rounded-md text-sm font-bold" style="color: ${tx.type === 'income' ? '#10B981' : tx.type === 'expense' ? '#EF4444' : '#6366F1'}; background: ${tx.type === 'income' ? '#E8F7F0' : tx.type === 'expense' ? '#FDE8E2' : '#EEF0FF'}">
        ${tx.type === 'income' ? '+' : tx.type === 'expense' ? '-' : '↔'}
      </span>
      <div class="flex-1 ml-2">
        <p class="text-xs font-bold text-[#354356] truncate">${escapeHtml(tx.description)}</p>
        <p class="text-xs text-[#9AA4AE]">${tx.type} • ${new Date(tx.date).toLocaleDateString('id-ID')} • <span class="text-[#5C8FC5]">${escapeHtml(tx.envelopeName || 'No envelope')}</span></p>
      </div>
      ${envelopeById.get(tx.envelopeId)?.currentAmount < 0 ? '<span class="mr-2 rounded bg-[#FDE8E2] px-1.5 py-1 text-[9px] font-bold text-[#C6533D]">Over budget</span>' : ''}
      ${tx.receiptImageUrl ? `<button type="button" class="mr-2 flex items-center gap-1 text-xs text-[#5C8FC5]" data-action="view-receipt" data-url="${escapeHtml(tx.receiptImageUrl)}" aria-label="View receipt">🧾 Receipt</button>` : ''}
      <div class="mr-2 text-xs font-bold" style="color: ${tx.type === 'income' ? '#10B981' : tx.type === 'transfer' ? '#6366F1' : '#D66D57'}">${formatAmount(tx)}</div>
      <button class="text-xs text-coral-600 mr-2" data-id="${tx.id}" data-action="edit">Edit</button>
      <button class="text-xs text-red-600" data-id="${tx.id}" data-action="delete">Delete</button>
    </div>`
  ).join('');
  panelEl.innerHTML = `<div class="border rounded">${rows}</div>`;
  panelEl.querySelectorAll('button[data-action]').forEach(btn => {
    const id = btn.getAttribute('data-id');
    const action = btn.getAttribute('data-action');
    if (action === 'delete') {
      btn.addEventListener('click', () => confirmDelete(id));
    } else if (action === 'edit') {
      btn.addEventListener('click', () => document.dispatchEvent(new CustomEvent('pocketflow:edit-transaction', { detail: { id } })));
    } else if (action === 'view-receipt') {
      btn.addEventListener('click', () => openReceiptModal(btn.getAttribute('data-url')));
    }
  });
}

let receiptObjectUrl = null;

function closeReceiptModal() {
  const modal = document.getElementById('receipt-modal');
  if (!modal) return;
  modal.style.display = 'none';
  modal.setAttribute('aria-hidden', 'true');
  const img = document.getElementById('receipt-modal-image');
  if (img) { img.src = ''; img.dataset.url = ''; }
  if (receiptObjectUrl) { URL.revokeObjectURL(receiptObjectUrl); receiptObjectUrl = null; }
  const error = document.getElementById('receipt-modal-error');
  if (error) { error.classList.add('hidden'); error.textContent = ''; }
}

async function openReceiptModal(receiptUrl) {
  const modal = document.getElementById('receipt-modal');
  const img = document.getElementById('receipt-modal-image');
  const error = document.getElementById('receipt-modal-error');
  if (!modal || !img || !error) return;
  modal.style.display = 'grid';
  modal.setAttribute('aria-hidden', 'false');
  error.classList.add('hidden');
  img.dataset.url = '';
  try {
    const res = await fetch(`${getApiUrl()}${receiptUrl}`, {
      headers: { Authorization: `Bearer ${localStorage.getItem('authToken') ?? ''}` }
    });
    if (!res.ok) throw new Error('Failed to load receipt image.');
    const blob = await res.blob();
    if (receiptObjectUrl) URL.revokeObjectURL(receiptObjectUrl);
    receiptObjectUrl = URL.createObjectURL(blob);
    img.src = receiptObjectUrl;
    img.dataset.url = receiptUrl;
  } catch (err) {
    img.src = '';
    error.textContent = err instanceof Error ? err.message : String(err);
    error.classList.remove('hidden');
  }
}

async function handleDeleteReceipt() {
  const img = document.getElementById('receipt-modal-image');
  const url = img?.dataset.url;
  if (!url) return;
  if (!confirm('Delete this receipt? The transaction itself will be kept.')) return;
  const error = document.getElementById('receipt-modal-error');
  try {
    const res = await fetch(`${getApiUrl()}${url}`, {
      method: 'DELETE',
      headers: { Authorization: `Bearer ${localStorage.getItem('authToken') ?? ''}` }
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error?.message || 'Failed to delete receipt.');
    closeReceiptModal();
    document.dispatchEvent(new CustomEvent('pocketflow:refresh-data'));
  } catch (err) {
    if (error) {
      error.textContent = err instanceof Error ? err.message : String(err);
      error.classList.remove('hidden');
    }
  }
}

function renderPagination(pagination) {
  const totalPages = pagination.totalPages;
  if (totalPages === 0) {
    paginationEl.replaceChildren();
    return;
  }
  paginationEl.innerHTML = `
    <button class="px-2 py-1 border rounded" id="prevBtn" ${state.page === 1 ? 'disabled' : ''}>Prev</button>
    <span>Page ${pagination.currentPage} of ${totalPages}</span>
    <button class="px-2 py-1 border rounded" id="nextBtn" ${state.page >= totalPages ? 'disabled' : ''}>Next</button>
  `;
  document.getElementById('prevBtn').addEventListener('click', () => { if (state.page > 1) { state.page--; load(); } });
  document.getElementById('nextBtn').addEventListener('click', () => { if (state.page < totalPages) { state.page++; load(); } });
}

function confirmDelete(id) {
  if (!confirm('Delete this transaction?')) return;
  const token = localStorage.getItem('authToken') ?? '';
  fetch(`${getApiUrl()}/api/transactions/${id}`, {
    method: 'DELETE',
    headers: { Authorization: `Bearer ${token}` }
  })
    .then(r => r.json())
    .then((data) => {
      if (!data.success) throw new Error(data.error?.message || 'Delete failed');
      document.dispatchEvent(new CustomEvent('pocketflow:refresh-data'));
    })
    .catch((error) => alert(error instanceof Error ? error.message : String(error)));
}

function setupFilters() {
  const types = ['', 'income', 'expense', 'transfer'];
  const container = filtersEl;
  container.innerHTML = `<div class="flex gap-2">${types.map(t => {
    const label = t === '' ? 'All' : t.charAt(0).toUpperCase() + t.slice(1);
    const active = state.type === t ? 'bg-[#FDE8E2] text-[#C6533D]' : 'bg-white';
    return `<button type="button" class="px-2 py-1 text-xs border rounded ${active}" data-type="${t}">${label}</button>`;
  }).join('')}</div><select id="transaction-envelope-filter" class="rounded border px-2 py-1 text-xs"><option value="">All envelopes</option>${envelopes.map(e => `<option value="${e.id}">${e.name}</option>`).join('')}</select>`;
  container.querySelectorAll('button').forEach(btn => {
    btn.addEventListener('click', () => {
      state.type = btn.getAttribute('data-type');
      state.page = 1;
      load();
    });
  });
  container.querySelector('#transaction-envelope-filter').addEventListener('change', (event) => {
    state.envelopeId = event.target.value;
    state.page = 1;
    load();
  });
}

async function refreshPanel() {
  try {
    const response = await fetch(`${getApiUrl()}/api/dashboard`, { headers: { Authorization: `Bearer ${localStorage.getItem('authToken') ?? ''}` } });
    const data = await response.json();
    if (data.success) {
      envelopes = data.data.envelopes;
      envelopeById = new Map(envelopes.map((envelope) => [envelope.id, envelope]));
      setupFilters();
    }
  } finally {
    await load();
  }
}

// Initialize on DOMContentLoaded
window.addEventListener('DOMContentLoaded', () => {
  panelEl = document.getElementById('transactions-list');
  filtersEl = document.getElementById('transactions-filters');
  paginationEl = document.getElementById('transactions-pagination');
  setupFilters();
  // Initial data loads wait for pocketflow:dashboard-ready so we never send a
  // stale localStorage token before AuthGate has renewed the session.
  document.addEventListener('pocketflow:refresh-data', refreshPanel);
  document.addEventListener('pocketflow:dashboard-ready', refreshPanel);

  const modal = document.getElementById('receipt-modal');
  modal?.querySelector('[data-receipt-close]')?.addEventListener('click', closeReceiptModal);
  modal?.querySelector('[data-receipt-delete]')?.addEventListener('click', handleDeleteReceipt);
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeReceiptModal();
  });
});
</script>

<section class="mt-6">
  <div class="flex justify-between items-center mb-4 max-[680px]:flex-col max-[680px]:items-stretch max-[680px]:gap-2">
    <div id="transactions-filters" class="flex gap-2"></div>
    <button class="px-3 py-1 text-sm bg-coral-500 text-white rounded max-[680px]:w-full max-[680px]:text-center" onclick="document.dispatchEvent(new CustomEvent('pocketflow:open-add-transaction'))">+ Add</button>
  </div>
  <div id="transactions-list"></div>
  <div id="transactions-pagination" class="flex justify-between items-center mt-2 text-xs"></div>
</section>

<div id="receipt-modal" class="fixed inset-0 z-30 hidden place-items-center bg-[rgba(25,39,53,.4)] p-5" aria-hidden="true">
  <div class="max-h-[90vh] w-full max-w-[410px] overflow-y-auto rounded-[10px] bg-white p-[29px] shadow-[0_20px_60px_rgba(23,37,51,.22)]" role="dialog" aria-modal="true" aria-label="Receipt">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="font-display text-xl font-semibold text-[#213043]">Receipt</h2>
      <button type="button" data-receipt-close class="border-0 bg-transparent text-[25px] text-[#82909D]" aria-label="Close dialog">×</button>
    </div>
    <p id="receipt-modal-error" class="hidden mb-2 text-xs text-red-600"></p>
    <img id="receipt-modal-image" alt="Receipt image" class="mx-auto max-h-[60vh] w-auto rounded" />
    <div class="mt-4 flex justify-end gap-2">
      <button type="button" data-receipt-close class="px-4 py-2 bg-gray-200 rounded text-sm">Close</button>
      <button type="button" data-receipt-delete class="px-4 py-2 bg-red-600 text-white rounded text-sm">Delete receipt</button>
    </div>
  </div>
</div>
