const transactions = [
  ['⌂', 'bg-[#F0EBFB] text-[#826BB3]', 'Rent payment', 'Home & utilities', 'Today, 09:42', '- Rp 2,400,000', 'text-[#D66D57]'],
  ['▤', 'bg-[#E8F2FC] text-[#5C8FC5]', 'Monthly salary', 'Income', 'Aug 01, 08:00', '+ Rp 18,500,000', 'text-[#42A27E]'],
  ['✦', 'bg-[#FFF0E4] text-[#D9895B]', 'Grocery run', 'Food & groceries', 'Jul 31, 18:24', '- Rp 420,000', 'text-[#D66D57]'],
  ['↗', 'bg-[#E3F5EF] text-[#4BA491]', 'Freelance project', 'Income', 'Jul 29, 14:10', '+ Rp 1,250,000', 'text-[#42A27E]'],
];
---

<article class="min-w-0" id="transactions"><div class="section-heading"><div><p class="kicker">ACTIVITY</p><h2 class="font-display text-xl font-semibold tracking-[-.5px] text-[#213043]">Recent transactions</h2></div><a class="text-link" href="#all-transactions">See all <span>→</span></a></div><div class="border-t border-[#E5E9E5]">{transactions.map(([icon, tone, name, category, date, amount, amountTone]) => <div class="flex min-h-[63px] items-center gap-3 border-b border-[#E8ECE8] max-[680px]:gap-2"><span class:list={['grid h-8 w-8 flex-none place-items-center rounded-md text-[17px] font-bold', tone]}>{icon}</span><div class="min-w-0 flex-1"><strong class="block truncate text-[11px] font-bold text-[#354356]">{name}</strong><small class="mt-1 block text-[9px] text-[#9AA4AE]">{category} <span class="mx-1 text-[#C2C8CD]">•</span> {date}</small></div><strong class:list={['whitespace-nowrap text-[11px]', amountTone]}>{amount}</strong></div>)}</div></article>
